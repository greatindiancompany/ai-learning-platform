# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_TIMEOUT_MS=90000
ANTHROPIC_MAX_RETRIES=3

# Supabase Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server
PORT=3000
NODE_ENV=development
# Comma-separated browser origins. Credentials are allowed only for this list.
# Production with an empty CORS_ORIGIN denies every browser origin.
CORS_ORIGIN=http://localhost:5173
# Number of trusted reverse-proxy hops. Use false only when nothing sits in front of Node.
TRUST_PROXY_HOPS=1

# Required in production. At least 32 characters. Do not use the placeholder.
JWT_SECRET=replace-with-a-long-random-secret

# Optional error reporting. Leave unset to disable Sentry. Do not commit a real DSN.
SENTRY_DSN=

# Demo seed script only. At least 10 characters. Do not commit real demo passwords.
DEMO_PARENT_PASSWORD=
DEMO_STUDENT_PASSWORD=

# Rotate the service-role key for historical project ksdnbkxixbywurohugkx in the
# Supabase dashboard before using this app against that project. Store the new
# key only in this environment file, which is gitignored.
